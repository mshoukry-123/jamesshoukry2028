{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/recruiting-film", "destination": "/recruiting-film/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jamesshoukry2028.vercel.app"
        }
      ],
      "destination": "https://www.jamesshoukry2028.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jamesshoukry2028.vercel.app"
        }
      ],
      "destination": "https://www.jamesshoukry2028.com/:path*",
      "permanent": true
    }
  ]
}
