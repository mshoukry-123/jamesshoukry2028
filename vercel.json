{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "jamesshoukry2028.vercel.app"
        }
      ],
      "destination": "https://www.jamesshoukry2028.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jamesshoukry2028.vercel.app"
        }
      ],
      "destination": "https://www.jamesshoukry2028.com/:path*",
      "permanent": true
    }
  ]
}
